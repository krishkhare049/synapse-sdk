{
  "name": "@khareindustries/synapse-sdk",
  "version": "0.1.3",
  "description": "JavaScript SDK for Synapse memory infrastructure",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "synapse",
    "memory",
    "ai",
    "sdk",
    "retrieval"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krishkhare049/synapse-sdk.git"
  },
  "homepage": "https://github.com/krishkhare049/synapse-sdk",
  "bugs": {
    "url": "https://github.com/krishkhare049/synapse-sdk/issues"
  }
}
